# NetBeans Build & Private Directory
build/
dist/
nbproject/private/

# NOTE: KHONG ignore cac file sau - BAT BUOC commit de ca nhom build giong nhau:
#   nbproject/project.xml, nbproject/project.properties,
#   nbproject/build-impl.xml, nbproject/genfiles.properties, nbproject/ant-deploy.xml
# Chi co nbproject/private/ la cau hinh rieng tung may nen moi ignore.


# Compiled Class Files & Packaging
*.class
*.war
*.ear
*.nar
target/
out/
bin/

# Keep JARs in WEB-INF/lib (runtime deps), exclude others
*.jar
!web/WEB-INF/lib/*.jar

# IDE Configuration Files (IntelliJ, Eclipse, VSCode)
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.vscode/
.factorypath

# Kiro AI steering files (local dev environment rules, not for sharing)
.kiro/steering/no-shell-no-admin.md

# Kiro AI agent task outputs & workflow artifacts
.agents/
.kiro/hooks/
.kiro/workflows/

# Log & Temporary Files
*.log
*.tmp
*.temp
*.swp
*~
hs_err_pid*
replay_pid*
.mtj.tmp/

# OS Specific Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Maven (if mixed project)
src/main/

# Tomcat deploy metadata
web/META-INF/context.xml

# Local secrets & credentials
application.properties
src/java/application.properties
!application.properties.example
oauth.properties
src/java/oauth.properties
cloudinary.properties
src/java/cloudinary.properties
db.properties
src/java/db.properties
mail.properties
src/java/mail.properties
*.env
.env.*
config.local.properties

# Local runner & deployment scripts
deploy.sh
rebuild.sh
run-mac.sh
setup_fedora.sh
start.sh
stop.sh

# Kiro IDE session store points
tore_point*
store_point*
*store_point*
